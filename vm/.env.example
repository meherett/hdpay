# Settings for docker compose itself, read from vm/.env (copy this file). The services' own settings
# are in ../envs/.

# on the VM: the example shop and nginx (hdpay.systems) start with a plain docker compose up -d
COMPOSE_PROFILES=example,nginx

# the example checkout's public address, for the links in the shop's emails
EXAMPLE_WEB_URL=https://example.hdpay.systems
