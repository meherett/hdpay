# The example shop's settings. Copy to example/api/.env and fill in.

# HDPay, and the project's secret key (hdp_sk_...): admin > Projects > the project > API keys.
# The key stays here, on the shop's server; the browser never sees it.
HDPAY_URL=http://localhost:8090
HDPAY_SECRET_KEY=

# Where this API listens, and the shop's web page (for links in emails and CORS).
HOST=127.0.0.1
PORT=8400
# development: restart when the code changes, so a page and its API never run out of step
RELOAD=true
WEB_URL=http://localhost:4400
CORS_ORIGINS=["http://localhost:4400"]

# Orders: which email belongs to which deposit, and the events already handled.
DATABASE=example.db

SHOP_NAME=Example Shop

# Email. Without SMTP_HOST the emails are only logged, which is enough to try the flow.
# Port 465 uses TLS from the start; any other port uses STARTTLS when SMTP_STARTTLS is true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Example Shop <shop@example.com>
SMTP_STARTTLS=true
