# envs/sweeper.env: the sweepers only. Never give this file to the API.
#
# The HD wallet's root key. Make it with (any shell):
#   python -m api.keys master --save
# It asks for your recovery phrase (hidden; leave it empty for a new wallet, whose phrase is shown once)
# and writes the key here.
# Every project's addresses and fee funders are derived from it.
HDPAY_MASTER_XPRV=
