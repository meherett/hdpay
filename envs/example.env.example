# The example shop's API, in docker compose (--profile example). Copy to envs/example.env.
# HDPAY_URL and WEB_URL are set in docker-compose.yml.

# a secret key of the project the shop sells for (admin -> project -> API keys)
HDPAY_SECRET_KEY=

SHOP_NAME=Example Shop

# without SMTP_HOST the emails are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Example Shop <shop@example.com>
SMTP_STARTTLS=true
