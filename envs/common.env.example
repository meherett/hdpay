# envs/common.env: every service (api, watchers, sweepers).
# The master key is not here: it goes in envs/sweeper.env, for the sweepers only.

# MongoDB, shared by all of them. Atlas: mongodb+srv://<user>:<password>@<cluster>/
HDPAY_MONGODB_URI=mongodb://localhost:27017
HDPAY_MONGODB_DB=hdpay

# Chains and tokens. Empty = chains.yaml in the repository (git-ignored, your private RPCs), else
# chains.example.yaml. HDPAY_RPC_URL_<CHAIN KEY> here overrides a chain's rpc_url (dashes become underscores).
HDPAY_CHAINS_FILE=

# Watcher loop interval, in seconds
HDPAY_POLL_INTERVAL_SECONDS=5

# Defaults for a new project; each project can change its own in the admin
HDPAY_DEPOSIT_TTL_MINUTES=30
HDPAY_AMOUNT_TOLERANCE_BPS=50
HDPAY_REMAINDER_WINDOW_MINUTES=1440
HDPAY_EVENT_RETENTION_DAYS=30

# ---- the API ----

# Admin sign-in: signs the short-lived access tokens. A long random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sign-in is off while it is empty.
HDPAY_JWT_SECRET=
HDPAY_ACCESS_TOKEN_MINUTES=15
HDPAY_REFRESH_TOKEN_DAYS=30

# The API server, and the browser apps allowed to call it (the hdpay web and admin apps)
HDPAY_PORT=8090
# true in development: restart when api/ code changes
HDPAY_RELOAD=false
HDPAY_CORS_ORIGINS=["http://localhost:4500"]
