# The HDPay web app (the admin), and its API on the same origin under /api/, so the browser needs no CORS.
# The official nginx image fills ${HDPAY_API_URL} in from the environment when the container starts.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # /api/... -> HDPAY_API_URL/...
    location /api/ {
        proxy_pass ${HDPAY_API_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        # an https HDPAY_API_URL behind Cloudflare (https://api.hdpay.systems) needs the name in the
        # TLS handshake, or it refuses it and every call is a 502; no effect on an http one
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # file names carry a hash of their content, so they can be cached for good
    location ~* \.(?:js|css|woff2?|ttf|png|jpe?g|svg|ico|webp)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # every other path is a page of the app: always the latest index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
